# =====================================================================
# maistrodx-scoreattack — environment variables (PLAN §10)
# Copy to `.env` (gitignored) and fill in real values.
# =====================================================================

# ----- Database (Postgres) -----
# Local dev: docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
# Production: Neon free tier recommended.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maistrodx?schema=public"

# ----- Better Auth -----
BETTER_AUTH_URL="http://localhost:3000"
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_API_KEY=

# ----- Google OAuth (Better Auth socialProviders.google) -----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----- Admin gating (PLAN decision #3) -----
# Comma-separated. Email must match the one returned by Google.
ADMIN_EMAILS=""

# ----- maimai data sync (PLAN §7) -----
MAIMAI_CF_BASE_URL="https://dp4p6x0xfi5o9.cloudfront.net/maimai"
# Community proxy for jacket images — must end with /.
# Server-side fallback; the client reads NEXT_PUBLIC_MAIMAI_IMAGE_BASE_URL.
MAIMAI_IMAGE_BASE_URL=""
NEXT_PUBLIC_MAIMAI_IMAGE_BASE_URL=""
# Random string; Vercel Cron sends this as `x-cron-secret` header.
MAIMAI_CRON_SECRET=""

# ----- Cloudinary (PLAN decision #9) -----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder prefix (organises uploads per-env).
CLOUDINARY_FOLDER="maistrodx"

# ----- Multi-instance deploys (PLAN §10, Next 16 Server Actions) -----
# Stable across instances so encrypted action refs stay decryptable.
# openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
